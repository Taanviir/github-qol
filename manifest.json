{
  "manifest_version": 3,
  "name": "GitHub QoL",
  "version": "0.3.0",
  "description": "Quality-of-life tweaks for GitHub: image lightbox, screenshot annotation, diff tools, absolute dates and more.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "GitHub QoL",
    "default_popup": "popup/popup.html"
  },
  "permissions": ["storage", "clipboardRead"],
  "host_permissions": [
    "https://camo.githubusercontent.com/*",
    "https://private-user-images.githubusercontent.com/*",
    "https://user-images.githubusercontent.com/*",
    "https://raw.githubusercontent.com/*",
    "https://objects.githubusercontent.com/*",
    "https://github.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*", "https://gist.github.com/*"],
      "js": [
        "src/core.js",
        "src/image-lightbox.js",
        "src/annotate-paste.js",
        "src/diff-tools.js",
        "src/absolute-dates.js",
        "src/expand-timeline.js",
        "src/linkify-paths.js",
        "src/sticky-blame.js",
        "src/shortcuts.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
